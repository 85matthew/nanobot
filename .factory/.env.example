# Factory Bootstrap Agent - Environment Variables
# Copy to .env and fill in values

# LiteLLM proxy URL (for model routing, rate limiting, failover)
LITELLM_PROXY_URL=http://localhost:4000

# Google AI API key (used by LiteLLM for Gemini models)
GOOGLE_API_KEY=your-key-here

# Optional: Override model cascade
# BUDGET_MODEL=gemini/gemini-2.5-flash-lite
# STANDARD_MODEL=gemini/gemini-2.5-flash
# PREMIUM_MODEL=gemini/gemini-2.5-pro
